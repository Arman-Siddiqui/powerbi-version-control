	column Amountt = 'Account Transaction'[debit] - 'Account Transaction'[credit]
		formatString: #,0
		lineageTag: a9fd743e-7c12-44e7-bb57-79d67df74058
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column PairKey =
			
			FORMAT('Account Transaction'[date], "dd-mm-yyyy")
			    & "|"
			    & FORMAT(ABS('Account Transaction'[Amountt]), "0.00")
		lineageTag: 7286639d-389d-4b4b-bd53-b9f191487ad0
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Pair Status' =
			
			VAR CurrentKey =
			    'Account Transaction'[PairKey]
			
			VAR TotalDebit =
			    CALCULATE(
			        SUM('Account Transaction'[debit]),
			        ALLEXCEPT(
			            'Account Transaction',
			            'Account Transaction'[PairKey]
			        )
			    )
			
			VAR TotalCredit =
			    CALCULATE(
			        SUM('Account Transaction'[credit]),
			        ALLEXCEPT(
			            'Account Transaction',
			            'Account Transaction'[PairKey]
			        )
			    )
			
			RETURN
			IF(
			    ROUND(TotalDebit,2) = ROUND(TotalCredit,2),
			    "Paired",
			    "Unpaired"
			)
		lineageTag: 3781550e-0a3c-470d-8705-8e4504e7ed81
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Acc Type' =
			
			IF (
			    'Account Transaction'[account_name] IN {
			        "Mashreq Silver Account XAG - 0559",
			        "Mashreq Trading Account - 8848",
			        "Mashreq Gold Account XAU - 1536",
			        "Yasmeen Payable A/C"
			    },
			    "Bank Other",
			    'Account Transaction'[offset_account_type]
			)
		lineageTag: 2a00903c-8240-46ca-8fe0-61afe3132e50
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Month Year' = FORMAT('Account Transaction'[date], "MMM-yyyy")
		lineageTag: 9e28ef9d-0ee7-46d6-bdbf-aa910f806f45
