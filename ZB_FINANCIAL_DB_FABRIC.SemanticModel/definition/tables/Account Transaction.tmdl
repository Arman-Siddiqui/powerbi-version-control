table 'Account Transaction'
	lineageTag: 81d51055-e42c-4366-8a5f-94b3ef32e438

	measure 'Contribution %' =
			
			DIVIDE(
			    [Amount Adjusted],
			    CALCULATE(
			        [Amount Adjusted],
			        ALLSELECTED('MAPPING'[Expense Acc])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9651ded2-6a2b-4ba5-b822-83bd76210fc7

