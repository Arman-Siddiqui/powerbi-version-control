table DateTable
	lineageTag: cf2af0e4-9d7f-4a52-ad4a-4dc2f785452c
	dataCategory: Time

	measure 'Dynamic Month Order' = ```
			
			VAR SelectedCompany = SELECTEDVALUE('Account Transaction'[_company_name])
			
			RETURN
			SWITCH(
			    TRUE(),
			    
			    SelectedCompany IN {"IQRA TECH","IQRA IT"}, 
			        SWITCH(
			            MONTH(MAX('DateTable'[Date])),
			            4,1, 5,2, 6,3, 7,4, 8,5, 9,6,
			            10,7, 11,8, 12,9, 1,10, 2,11, 3,12
			        ),
			
			    MONTH(MAX('DateTable'[Date]))
			)
			```
		formatString: 0
		lineageTag: 302b98bb-68b2-48ff-b41d-6e6cb34669f4

