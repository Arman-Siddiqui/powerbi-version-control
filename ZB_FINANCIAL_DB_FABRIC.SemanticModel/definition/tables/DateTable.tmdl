		level Month
			lineageTag: a7b121e6-fc21-4ae3-87b5-794e97412a9b
			column: Month

	partition DateTable = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2020,1,1), DATE(2027,12,31)),
				
				    -- Basic Columns
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "Month", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MMM"),
				
				    -- Indian Financial Year
				    "Financial Year",
				        VAR YearValue = YEAR([Date])
				        VAR MonthValue = MONTH([Date])
				        RETURN 
				        IF(
				            MonthValue >= 4,
				            YearValue & "-" & RIGHT(YearValue + 1,2),
				            (YearValue - 1) & "-" & RIGHT(YearValue, 2)
				        ),
				
				    -- Financial Year Start Year (for sorting)
				    "FY Start Year",
				        IF(MONTH([Date]) >= 4, YEAR([Date]), YEAR([Date]) - 1),
				    "Month Year Sort",
				    YEAR([Date]) * 100 + MONTH([Date]),
				    "Year Sort",
				    YEAR([Date]),
				    "FY Sort Desc",
				    -IF(
				        MONTH([Date]) >= 4,
				        YEAR([Date]),
				        YEAR([Date]) - 1
				    ),"Year Sort Desc",
				-YEAR([Date]),
				
				    -- Financial Month Number (Apr = 1, Mar = 12)
				    "FY Month Number",
				        MOD(MONTH([Date]) - 4, 12) + 1,
				
				    -- Financial Quarter
				    "FY Quarter",
				        "Q" & ROUNDUP(DIVIDE(MOD(MONTH([Date]) - 4, 12) + 1, 3), 0)
				)
				```

	annotation PBI_Id = b4a63ad2b85d4002b577dbb74da48e36

