	measure 'Amount Converted' =
			
			
			VAR SelectedCurrency =
			    SELECTEDVALUE(
			        CurrencySelector[Currency],
			        "Base"
			    )
			
			RETURN
			
			SUMX(
			    'Account Transaction',
			
			    VAR CompanyName =
			        TRIM(UPPER('Account Transaction'[_company_name]))
			
			    VAR IsINRCompany =
			        CompanyName IN {"IQRA IT","IQRA TECH"}
			
			    VAR INRtoAED =
			        RELATED('Exchange Rate'[INR_TO_AED])
			
			    VAR AEDtoINR =
			        RELATED('Exchange Rate'[Aed to Inr])
			
			    VAR Amount =
			        [Amount Adjusted]
			
			
			    RETURN
			
			    SWITCH(
			
			        SelectedCurrency,
			
			        "Base",
			            Amount,
			
			        "INR",
			            IF(
			                IsINRCompany,
			                Amount,
			                Amount * AEDtoINR
			            ),
			
			        "AED",
			            IF(
			                IsINRCompany,
			                Amount * INRtoAED,
			                Amount
			            )
			    )
			)
		formatString: #,0
		lineageTag: c5b9393c-38fe-45a0-98fb-11fe87753efb

	measure 'Previous Year Amount Adjusted' =
			
			CALCULATE(
			    [Amount Adjusted],
