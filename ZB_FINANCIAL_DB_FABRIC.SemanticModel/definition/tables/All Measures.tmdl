		lineageTag: f4eff1c4-72b0-42ac-85ee-ca564d00f09a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit and Loss' = CALCULATE([Amount Adjusted],MAPPING[Level 1 ] = "operating Income") - CALCULATE([Amount Adjusted],MAPPING[Level 1 ] = "operating Expense")
